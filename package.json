{
  "name": "cost-down",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "watch": "tsx scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && web-ext build -s dist/chrome -a dist/packages -n cost-down-chrome-{version}.zip -o && web-ext build -s dist/firefox -a dist/packages -n cost-down-firefox-{version}.zip -o",
    "lint:firefox": "web-ext lint -s dist/firefox",
    "package:source": "node -e \"require('fs').mkdirSync('dist/packages',{recursive:true})\" && git archive --format=zip -o dist/packages/cost-down-source-$npm_package_version.zip HEAD",
    "sign:firefox": "tsx scripts/sign-firefox.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "web-ext": "^10.8.0"
  },
  "license": "MIT"
}
